# Makefile.local.sample
# ----------------------
# Copy this file to "Makefile.local" when you need to override build variables or add
# project-specific targets. It is read once, after the build defaults and before
# everything that derives values from them. An override here therefore reaches
# the toolchain selection and the derived sysroot paths (PKG_CONFIG_PATH etc.),
# while a dependent override such as `N_PLUGIN_DIR := $(N_PREFIX)/oem/plugins`
# can still reference a default. Overriding ROOT_DIR moves all the derived
# directories with it. The default goal stays `help`, so a target defined here
# does not silently become what a bare `make` runs.
#
# Because this file is read early, a custom TARGET here can call core targets via
# `$(MAKE) <target>` but cannot list a variable defined by a later module as a
# prerequisite. Put such late-binding targets in "Makefile.local.post" instead,
# which is read after every module (e.g. `my-build: $(NEUTRINO_INSTALL_STAMP)`).
# Every entry below is commented out – remove the leading "#" to activate the line.

###############################
#  General build parameters   #
###############################

#ALLOW_NON_ROOT := 1
#  Relax root requirements for selected targets such as `make deps` or `make run-now`.
#  Default is 0 (root erforderlich). `make run` bevorzugt systemd-nspawn; mit ALLOW_NON_ROOT=1
#  fällt es auf proot zurück, wenn verfügbar (ansonsten Host-Wrapper).

#MAKE_JOBS := 8
#  Fixed number of parallel jobs. By default the CPU count is detected automatically.

#NEUTRINO_BRANCH := master
#NEUTRINO_GIT_URL := https://github.com/tuxbox-neutrino/neutrino.git
#  Source and branch for the Neutrino core. Adjust for forks or pinned tags.

#NEUTRINO_CONFIGURE_FLAGS := --enable-debug
#  Additional `./configure` flags forwarded to the core build.

#LIBSTB_HAL_CONFIGURE_FLAGS := --enable-gstreamer
#  Additional `./configure` flags forwarded to libstb-hal (e.g. enable GStreamer playback).

#NEUTRINO_CFLAGS_APPEND := -g3 -O0
#NEUTRINO_CXXFLAGS_APPEND := -g3 -O0
#  Extra compiler flags (useful for debug builds or stricter warnings). Defaults already include a
#  curated warning set; override `NEUTRINO_WARN_OPTS` / `NEUTRINO_WARN_OPTS_CXX` to replace it entirely.

#DEBUG_BUILD := 0
#ENABLE_ASAN := 0
#ENABLE_TSAN := 0
#ENABLE_UBSAN := 0
#  Toggle debug/ sanitizer builds. DEBUG_BUILD=1 setzt -O0/-g3/fno-omit-frame-pointer.
#  ASAN/TSAN/UBSAN hängen die passenden -fsanitize-Flags an C/CXX/LDFLAGS:
#    ENABLE_ASAN=1  -> -fsanitize=address
#    ENABLE_UBSAN=1 -> -fsanitize=undefined
#    ENABLE_TSAN=1  -> -fsanitize=thread
#  Hinweis: ASAN und TSAN sind gegenseitig exklusiv.

#PREFERRED_FFMPEG_VERSION := 5.1.4
#FFMPEG_VERSION := 6.1.1
#  Default ffmpeg version used by deps-ffmpeg (and overridden by deps-ffmpeg-<ver>). PREFERRED_FFMPEG_VERSION
#  sets the global default; FFMPEG_VERSION overrides per invocation. Use `make deps-ffmpeg-<ver>` to pin a
#  specific release without editing this file.
#FFMPEG_USE_SYSTEM := 1
#  Use the host ffmpeg if available and version-matching; default is 0 (always build locally into the sysroot).
#FFMPEG_CONFIGURE_FLAGS := --enable-nonfree --enable-libx264
#  Additional flags passed to ffmpeg's ./configure after the built-in line (e.g. to enable nonfree/GPL
#  codecs or custom hwaccels). The built-in line enables gnutls for https; `--disable-gnutls` here opts
#  out -- add it whenever you pick another TLS backend (--enable-openssl, --enable-mbedtls), ffmpeg's
#  configure refuses two at once. A changed value reconfigures and rebuilds ffmpeg on the next make.

#NEUTRINO_GDB_AUTORUN := 0
#NEUTRINO_GDB_COMMANDS := break main;bt
#  Fine-tune `make run-gdb`. With AUTORUN=0 gdb stops at the prompt; additional commands are executed
#  before the optional `run` (semicolon-separated list).

#NEUTRINO_LUA_FLAVOR := luajit
#  Selects the Lua runtime (luajit, lua, system). See README for details.

#TOOLCHAIN_GCC_VERSION := 15
#CC := $(ROOT_DIR)/artifacts/toolchains/gcc-15.2.0/bin/gcc-15
#CXX := $(ROOT_DIR)/artifacts/toolchains/gcc-15.2.0/bin/g++-15
#DEBUG_BUILD := 1
#  GCC selection: use TOOLCHAIN_GCC_VERSION for versioned distro packages (`make neutrino-gcc-15`
#  expects gcc-15/g++-15 on PATH; TOOLCHAIN_GCC_VERSION=system keeps the host default, e.g. gcc-12).
#  For a self-built toolchain (e.g. via scripts/build_gcc.sh), point CC/CXX at the installed binaries
#  or prepend PATH accordingly. DEBUG_BUILD=1 enables -O0 -g3 etc.

#######################################
#  Directory / path layout overrides  #
#######################################

#ROOT_DIR := $(abspath $(CURDIR))
#ARCHIVE_DIR := $(ROOT_DIR)/archive
#SOURCES_DIR := $(ROOT_DIR)/sources
#BUILD_DIR := $(ROOT_DIR)/build
#OUTPUT_DIR := $(ROOT_DIR)/artifacts
#CACHE_DIR := $(ROOT_DIR)/.cache
#LOG_DIR := $(ROOT_DIR)/logs
#VENV_DIR := $(ROOT_DIR)/.venv
#  Core working directories; defaults are relative to the repository root.

#PLUGINS_DIR := $(ROOT_DIR)/plugins
#  Location of custom plugin sources. Can point to a dedicated staging repository.

#NEUTRINO_INSTALL_DIR := $(OUTPUT_DIR)/sysroot
#NEUTRINO_RUNTIME_PREFIX := $(ROOT_DIR)/root
#NEUTRINO_PREFIX := /usr
#  Installation path and runtime staging directory for the Neutrino core. To relocate the actual
#  storage (e.g. `/opt/neutrino`), adjust `NEUTRINO_INSTALL_DIR` and `NEUTRINO_RUNTIME_PREFIX`.
#  Note: `NEUTRINO_PREFIX` describes the logical prefix inside the sysroot – do not point it at a
#  host directory. After changing `NEUTRINO_INSTALL_DIR`, rerun `make deps` once so dependencies
#  rebuild into the new location.

# Example: host runtime tweaks
#NEUTRINO_RUNTIME_PREFIX := $(ROOT_DIR)/root
#  Pfad für das gestagte Laufzeit-Root. Standard ist bereits $(ROOT_DIR)/root; anpassen, wenn ein anderer
#  Speicherort gewünscht ist (z. B. separater SSD-Mount).
#
#RUN_NEUTRINO_DISPLAY := :99
#  DISPLAY, das `make run` nutzt. Standard ist $DISPLAY des Hosts (Fallback :99).
#
#NEUTRINO_HEADLESS_BACKEND := xvfb
#  Headless Backend für GUI-Tests/Headless-Starts (xvfb oder xpra, falls installiert).
#
#NEUTRINO_RUN_WRAPPER := gdb --args
#  Optionaler Wrapper für den Start (z. B. gdb, valgrind). Beispiel:
#  NEUTRINO_RUN_WRAPPER="valgrind --tool=memcheck" make run-now
#
#SIMULATE_FE := 0
#  Der Host-Wrapper (`root/usr/bin/neutrino`) setzt standardmäßig `SIMULATE_FE=1`, damit Neutrino
#  auch ohne DVB-Hardware stabil bleibt. Überschreibe die Variable hier, falls du andere Werte vorgeben möchtest.
#
#TUXWETTER_GIT_URL := https://github.com/tuxbox-neutrino/plugin-tuxwetter
#TUXWETTER_GIT_REF := main
#  Quelle für das Tuxwetter-Plugin (Auto-Clone nach plugins/tuxwetter). Ref ist optional.
#
#WEBTV_SRC := $(ROOT_DIR)/sources/plugin-scripts-lua/plugins/webtv
#  Verzeichnis mit den WebTV-Skripten und -Listen. Standardmäßig kommen sie aus
#  plugin-scripts-lua, das bei Bedarf geklont wird. Zeigt die Variable woanders hin,
#  wird nichts geklont — praktisch für einen eigenen Checkout oder ein künftiges
#  eigenes WebTV-Repository.
#
#NEUTRINO_WEB_PORT := 31344
#  Port des yWeb-Interfaces, der beim erstmaligen Erzeugen von `root/usr/var/tuxbox/config/nhttpd.conf`
#  durch `make runtime-sync` gesetzt wird. Bestehende Werte werden nicht überschrieben.
#
#NEUTRINO_WEB_HOST := 0.0.0.0
#  Bind-Adresse des Webservers. `0.0.0.0` bedeutet „alle Interfaces“. Setze z. B. `127.0.0.1`, um das
#  Interface ausschließlich lokal verfügbar zu machen. `make runtime-sync` trägt den Wert nur beim
#  erstmaligen Anlegen von `nhttpd.conf` ein.

#VALGRIND := valgrind
#GDB := gdb
#  Optionale overrides für Werkzeuge, falls sie nicht im PATH oder unter anderem Namen liegen.

#PYTHON := python3
#PIP := pip3
#  By default the project venv (.venv) is used when present. Set these to opt out
#  of the venv and use the host interpreter (or point them at a specific one).

############################################
